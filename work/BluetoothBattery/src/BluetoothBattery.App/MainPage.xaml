<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BluetoothBattery_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BluetoothBattery_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="无线设备电量" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="只读识别蓝牙与 2.4G 无线设备电量，不修改设备设置" />
            </StackPanel>

            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                MinWidth="96"
                Click="RefreshButton_Click"
                ToolTipService.ToolTip="立即刷新设备电量">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="设备" />
                    <TextBlock x:Name="DeviceCountText" FontSize="22" FontWeight="SemiBold" Text="0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="已连接" />
                    <TextBlock x:Name="ConnectedCountText" FontSize="22" FontWeight="SemiBold" Text="0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="电量已知" />
                    <TextBlock x:Name="BatteryCountText" FontSize="22" FontWeight="SemiBold" Text="0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ToggleSwitch
                x:Name="AutoRefreshSwitch"
                Header="自动刷新"
                IsOn="True"
                OffContent="关闭"
                OnContent="开启"
                Toggled="AutoRefreshSwitch_Toggled" />

            <ProgressRing
                x:Name="RefreshProgress"
                Grid.Column="1"
                Width="24"
                Height="24"
                VerticalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="LastRefreshText"
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="尚未刷新" />
        </Grid>

        <ListView
            x:Name="DeviceList"
            Grid.Row="3"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DeviceRow">
                    <Grid Padding="4,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Kind}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind StableId}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Battery}" />
                            <ProgressBar
                                Maximum="100"
                                Minimum="0"
                                Value="{x:Bind BatteryValue}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind BatterySource}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind BatteryMeta}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyStateText"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="未发现高置信度在线无线设备"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="就绪" />
    </Grid>
</Page>
